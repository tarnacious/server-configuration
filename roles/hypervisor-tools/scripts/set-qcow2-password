#!/bin/bash
# Write a runtime password hash to an offline, whole-filesystem QCOW2 keys disk.
# Usage: set-qcow2-password <qcow2-image> [username]
set -Eeuo pipefail
umask 077

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script must be run as root" >&2
    exit 1
fi
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "Usage: $0 <qcow2-image> [username]" >&2
    exit 1
fi
IMAGE="$1"
USERNAME="${2:-tarn}"
if [[ ! "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    echo "ERROR: Invalid username" >&2
    exit 1
fi
[ -f "$IMAGE" ] || { echo "ERROR: Image not found: $IMAGE" >&2; exit 1; }
for tool in qemu-nbd openssl modprobe flock virsh python3 mount umount mktemp mv; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "ERROR: Required command not found: $tool" >&2
        exit 1
    }
done
exec 9>/run/lock/server-configuration-nbd.lock
flock -x 9

# Reject any active system-libvirt domain referencing this image, including
# backing stores and aliases. Failure to inspect a domain is a hard failure.
python3 - "$IMAGE" <<'PY'
import os, subprocess, sys, xml.etree.ElementTree as ET
image = os.path.realpath(sys.argv[1])
def virsh(*args):
    return subprocess.check_output(['virsh', '-c', 'qemu:///system', *args], text=True)
for uuid in virsh('list', '--uuid').split():
    domain = ET.fromstring(virsh('dumpxml', uuid))
    for source in domain.findall('./devices/disk//source'):
        path = source.get('file') or source.get('dev')
        if path and (os.path.realpath(path) == image or
                     (os.path.exists(path) and os.path.samefile(path, image))):
            sys.exit('ERROR: Image is attached to an active VM; shut it down first')
PY

modprobe nbd max_part=16
NBD_DEV=""
for i in {0..15}; do
    if [ -e "/dev/nbd${i}" ] && [ ! -e "/sys/block/nbd${i}/pid" ]; then
        NBD_DEV="/dev/nbd${i}"
        break
    fi
done
[ -n "$NBD_DEV" ] || { echo "ERROR: No free NBD device" >&2; exit 1; }
MOUNT_DIR="$(mktemp -d /tmp/qcow2-password.XXXXXX)"
CONNECTED=false
MOUNTED=false
HASH_FILE=""
cleanup() {
    local status=$?
    trap - EXIT
    if [ -n "$HASH_FILE" ]; then rm -f -- "$HASH_FILE" || status=1; fi
    if [ "$MOUNTED" = true ]; then
        if ! umount "$MOUNT_DIR"; then
            echo "ERROR: Unmount failed; leaving $NBD_DEV connected at $MOUNT_DIR" >&2
            exit 1
        fi
    fi
    if [ "$CONNECTED" = true ]; then
        qemu-nbd --disconnect "$NBD_DEV" || status=1
    fi
    rmdir "$MOUNT_DIR" || status=1
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Keep QEMU's exclusive image locking enabled: this also rejects writers outside
# system libvirt, and a VM racing the inspection above. Never use --shared/force.
qemu-nbd --format=qcow2 --connect="$NBD_DEV" "$IMAGE"
CONNECTED=true
sleep 1
mount -o nosuid,nodev,noexec "$NBD_DEV" "$MOUNT_DIR"
MOUNTED=true
read -r -s -p "Password for $USERNAME: " PASSWORD
printf '\n'
read -r -s -p "Repeat password: " PASSWORD2
printf '\n'
[ "$PASSWORD" = "$PASSWORD2" ] || { echo "ERROR: Passwords do not match" >&2; exit 1; }
[ -n "$PASSWORD" ] || { echo "ERROR: Password cannot be empty" >&2; exit 1; }
HASH_FILE="$(mktemp "$MOUNT_DIR/.password.XXXXXX")"
printf '%s\n' "$PASSWORD" | openssl passwd -6 -stdin > "$HASH_FILE"
unset PASSWORD PASSWORD2
chmod 600 "$HASH_FILE"
# Rename replaces a destination symlink rather than following it. -T rejects
# directories instead of moving the hash inside them.
mv -fT -- "$HASH_FILE" "$MOUNT_DIR/$USERNAME-password"
HASH_FILE=""
sync
# Report success only after the filesystem is unmounted and NBD disconnected.
umount "$MOUNT_DIR"
MOUNTED=false
qemu-nbd --disconnect "$NBD_DEV"
CONNECTED=false
echo "Created $USERNAME-password on $IMAGE"
