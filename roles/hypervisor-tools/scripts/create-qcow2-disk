#!/bin/bash
# Create a new QCOW2 image containing a labeled ext4 filesystem.
# Usage: create-qcow2-disk <path> <label> <size>
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script must be run as root" >&2
    exit 1
fi
if [ "$#" -ne 3 ]; then
    echo "Usage: $0 <path> <label> <size>" >&2
    exit 1
fi
DISK_PATH="$1"
LABEL="$2"
SIZE="$3"

if [ -z "$LABEL" ] || [ "${#LABEL}" -gt 16 ]; then
    echo "ERROR: ext4 label must contain 1–16 characters" >&2
    exit 1
fi
for tool in qemu-img qemu-nbd mkfs.ext4 modprobe flock; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "ERROR: Required command not found: $tool" >&2
        exit 1
    }
done

# Serialize this tool's device selection and disk creation. Other NBD tools must
# still respect device ownership; a failed connection never permits formatting.
exec 9>/run/lock/server-configuration-nbd.lock
flock -x 9

if [ -e "$DISK_PATH" ] || [ -L "$DISK_PATH" ]; then
    echo "ERROR: Disk image already exists at $DISK_PATH" >&2
    exit 1
fi
modprobe nbd max_part=16
NBD_DEV=""
for i in {0..15}; do
    if [ -e "/dev/nbd${i}" ] && [ ! -e "/sys/block/nbd${i}/pid" ]; then
        NBD_DEV="/dev/nbd${i}"
        break
    fi
done
if [ -z "$NBD_DEV" ]; then
    echo "ERROR: No free NBD device; no image created" >&2
    exit 1
fi

CONNECTED=false
CREATED=false
cleanup() {
    local status=$?
    trap - EXIT
    if [ "$CONNECTED" = true ]; then
        if ! qemu-nbd --disconnect "$NBD_DEV"; then
            echo "ERROR: Could not disconnect $NBD_DEV; inspect it before reuse" >&2
            status=1
        fi
    fi
    if [ "$status" -ne 0 ] && [ "$CREATED" = true ]; then
        echo "ERROR: Disk creation did not complete; inspect partial image: $DISK_PATH" >&2
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$(dirname "$DISK_PATH")"
# Reserve the path exclusively, including against other creators of this image.
(set -o noclobber; : > "$DISK_PATH")
CREATED=true
qemu-img create -f qcow2 "$DISK_PATH" "$SIZE"
qemu-nbd --connect="$NBD_DEV" "$DISK_PATH"
CONNECTED=true
sleep 2
mkfs.ext4 -L "$LABEL" "$NBD_DEV"
qemu-nbd --disconnect "$NBD_DEV"
CONNECTED=false
# Do not unload a shared kernel module that another process may now be using.
echo "Successfully created and formatted disk: $DISK_PATH (ext4, label $LABEL, size $SIZE)"
